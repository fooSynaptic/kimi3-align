{
  "schema_version": 1,
  "eval_protocol": {
    "task": "MATH boxed accuracy",
    "dataset": "DigitalLearningGmbH/MATH-lighteval",
    "split": "test",
    "n": 256,
    "sample_seed": 1,
    "sampling": {
      "temperature": 0.0,
      "max_tokens": 1024,
      "stop": [
        "<|im_end|>"
      ]
    },
    "prompt": "problem + 'Please reason step by step, and put your final answer within \\boxed{}.' via Qwen chat template",
    "grader": "math_verify.parse/verify; fallback last_boxed string match",
    "script": "scripts/math_boxed_probe.py",
    "gate_rule": "same-batch delta vs designated baseline; default tolerate >= -2pp"
  },
  "train_defaults": {
    "seed": 1,
    "model": "Qwen3-4B-Instruct-2507",
    "data": "gsm8k_hard",
    "total_train_steps_nominal": 200,
    "recipe_R": {
      "group_size": 8,
      "mask_alpha_beta": [
        0.2,
        5.0
      ],
      "tau_R": 0.01,
      "clip": 0.2,
      "kl_ctl": 0,
      "adam_lr": 1e-06
    },
    "gen_train": {
      "max_new_tokens": 512,
      "temperature": 1.0
    }
  },
  "trials": [
    {
      "claim_ids": [
        "C0"
      ],
      "phase": "P0",
      "trial": null,
      "config": null,
      "note": "cold-start gate only; no RL trial"
    },
    {
