# Copy to .env and fill locally. Real values stay gitignored (see .gitignore).
# Source before train/eval:  set -a && source .env && set +a
#
# Tier-1 (no GPU): only K3_ROOT is required — run ./scripts/verify.sh
# Tier-2 (cluster): fill every required variable below.

# --- This repo ---
K3_ROOT=

# --- SAO + AReaL runtime (see docs/manifests/upstream_pins.json) ---
# SAO: main @ ac2728149041b5f15ceb75413f467ce0659179cf
# AReaL: 3cf0dfbd2b0fbeabd6977184980e189d1567747a (via SAO bootstrap)
SAO_ROOT=
AREAL_REPO=
VENV=

# Model + RL data (gsm8k_hard prepared via SAO scripts/prepare_math.py)
MODEL_PATH=
DATA_PATH=

# AReaL RPC admin key (optional; YAML defaults are local trial-scoped strings)
# K3_ADMIN_API_KEY=k3-align-local-dev

# --- Ray cluster (Tier-2 train only; use your SSH Host aliases) ---
HEAD_SSH=
HEAD_HOST=
# Format: alias:ngpus:cvd alias:ngpus:cvd  (example: worker-a:8:0,1,2,3,4,5,6,7)
WORKER_SPECS=

# --- Boxed eval hosts (Tier-2 eval; can be 1–2 nodes with spare GPUs) ---
HOST_A=
HOST_B=

# --- Optional: E0 launch script reads first two worker aliases from this list ---
# WORKER_HOSTS=worker-a worker-b
